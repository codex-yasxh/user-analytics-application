{
  "name": "causalfunnel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "tracker",
    "dashboard"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:sync": "tsx scripts/sync-indexes.ts",
    "copy-demo": "tsx scripts/copy-demo.ts",
    "build": "npm run build -w @cf/tracker && npm run copy-demo && npm run build -w @cf/dashboard",
    "dev": "npm run copy-demo && concurrently -k \"npx tsx watch --env-file=.env server/src/index.ts\" \"npm run dev -w @cf/dashboard\" \"npx tsx watch --include tracker/src/index.ts tracker/build.ts\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.13",
    "@rolldown/binding-win32-x64-msvc": "^1.2.13"
  }
}
